# Public hostname pointing at this server, e.g. addex.duckdns.org
ADDEX_DOMAIN=addex.example.org

# Long random string, e.g. from: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# Optional: shown as the "Report" contact in Stremio's addon details.
ADDEX_CONTACT_EMAIL=

# Optional: signature from stremio-addons.net, added to the manifest as
# stremioAddonsConfig to verify the listing. Issued for this deployment's URL.
ADDEX_STREMIO_ADDONS_SIGNATURE=
